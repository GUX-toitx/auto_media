OPENAI_KEY=
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_PRIVATE_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

MEDIA_DIR=
VOICE_API=
API_KEY=
TENANT=
# ---- Nhà cung cấp AI: openai | deepseek ----
AI_PROVIDER=openai
OPENAI_KEY=
# DeepSeek (rẻ hơn nhiều). Lấy key tại https://platform.deepseek.com
DEEPSEEK_KEY=
# Model DeepSeek (để trống dùng mặc định)
DEEPSEEK_MODEL_MAIN=deepseek-v4-pro
DEEPSEEK_MODEL_STD=deepseek-v4-flash
DEEPSEEK_MODEL_MINI=deepseek-v4-flash
# Nhiều profile X = nhiều account twscrape = throttle nhân lên
X_PROFILES=chrome-profile-4,chrome-profile-6

# ---- Lịch monitor Địa chính trị ----
# Chạy 2 lần/ngày (06:00 & 13:00), mỗi lần tạo 2 dự án = 4 dự án/ngày
GEO_RUN_TIMES=06:00,13:00
GEO_PROJECTS_PER_RUN=2
# Chống trùng vấn đề: đối chiếu với N dự án geo gần nhất (0 = tắt)
GEO_DEDUP_LOOKBACK=20

# ---- Xoá nền clip Lips Sync khi xuất CapCut ----
# matting (mặc định) = ghi sẵn cờ "Xoá nền tự động" (智能抠像) của CapCut vào draft, mở lên là hết nền
# green              = dùng bản RVM đã matte (N_green.mp4, nền xanh) — phải bấm Chroma key trong CapCut
# off                = giữ nguyên nền gốc
LIPS_BG_REMOVAL=matting
# Python có torch+CUDA để chạy src/workers/matte_lips.py (chỉ cần cho chế độ green)
MATTE_PYTHON=/home/gux/workspace/lips_sync/lips_sync/.venv/bin/python

# ---- Tự chọn ảnh/video cho từng cảnh (src/workers/auto_select.js) ----
# Crawl xong thì tự chạy luôn (1 = bật). Mặc định tắt vì mỗi lượt chiếm GPU vài chục giây,
# mà GPU còn phải nuôi server lips-sync — tắt thì bấm nút 🤖 trên UI khi cần.
AUTO_SELECT_ON_CRAWL=0
# Model chấm độ hợp cảnh. SigLIP 2 hiểu đa ngữ (chấm được cả câu tiếng Việt/Nhật/Hàn),
# CLIP chỉ tiếng Anh nhưng nhẹ hơn — dùng làm phương án dự phòng khi tải model chính hỏng.
MEDIA_SCORE_MODEL=google/siglip2-base-patch16-224
MEDIA_SCORE_MODEL_FALLBACK=openai/clip-vit-base-patch32
# GPU còn ít hơn ngần này (MB) thì chấm bằng CPU cho khỏi giành VRAM của lips-sync
MEDIA_SCORE_MIN_VRAM_MB=1500
# Nhịp dựng: mỗi ảnh mấy giây, video cắt trong khoảng nào
AUTOSEL_IMG_SEC=4
AUTOSEL_IMG_MIN=2.5
AUTOSEL_IMG_MAX=6
AUTOSEL_CLIP_MIN=3
AUTOSEL_CLIP_MAX=8
# Lọc chất lượng: ảnh hẹp hơn / dọc hơn mức này bị xếp xuống hạng dưới (không loại hẳn)
AUTOSEL_MIN_W=1000
AUTOSEL_MIN_RATIO=1.2

# ---- Ép video về Full HD khi xuất CapCut ----
# Kho stock toàn clip 4K (có file 385MB cho 20 giây) -> draft CapCut phình vài GB, export lẫn tải về
# đều lê thê, trong khi dựng xong cũng chỉ xuất 1080p. Bản hạ được cache ở MEDIA_DIR/_hd1080/ nên
# mỗi clip chỉ encode MỘT LẦN, mọi dự án dùng lại.
# Đặt CAPCUT_MAX_HEIGHT=0 để tắt hẳn (giữ nguyên bản gốc).
CAPCUT_MAX_WIDTH=1920
CAPCUT_MAX_HEIGHT=1080
# Bitrate bản hạ. 5M: nhẹ ~4.4 lần, chất lượng tốt. 3M: nhẹ ~7 lần, cảnh động nhiều sẽ hơi bết.
CAPCUT_VIDEO_BITRATE=5M

# ---- Hàng đợi Podcast ----
# Hạn giờ chờ 1 batch TTS xong. Mặc định 20 phút (cũ) là quá ngắn cho bài 600 câu: hết giờ thì dây
# chuyền tưởng voice hỏng, xuất ra draft rỗng ~46KB. Đã nâng lên 90 phút.
AUTO_VOICE_TIMEOUT_MS=5400000
# Sau khi chờ batch xong, ngó thêm bấy nhiêu lâu xem audio đã vào DB chưa rồi mới quyết dừng hay chạy tiếp.
PODCAST_VOICE_GRACE_MS=300000

# ---- Podcast: nội dung do AI viết (src/workers/podcast_ai.js) ----
# Dùng chung AI_PROVIDER/OPENAI_KEY/DEEPSEEK_KEY ở đầu file.
# Tốc độ đọc để quy "phút" ra số từ, và cỡ mỗi lượt gọi (1 lượt không viết nổi cả bài 20 phút).
PODCAST_AI_WPM=150
PODCAST_AI_WORDS_PER_SECTION=900
# Mức suy luận: dàn ý sai là hỏng cả bài nên để 'high'; viết từng phần gọi nhiều lượt nên 'medium' cho nhanh.
PODCAST_AI_OUTLINE_EFFORT=high
PODCAST_AI_SECTION_EFFORT=medium
PODCAST_AI_MAX_OUTPUT_TOKENS=32000
# Trần độ dài 1 câu đọc (ký tự) — dài quá thì mp3 lê thê, khó lấp nền.
PODCAST_AI_MAX_UNIT_CHARS=180

# ---- Podcast: bộ nhớ chống trùng (<MEDIA_DIR>/_podcast_ai/memory.json) ----
# Số lần bắt AI lên lại dàn ý khi trùng nhân vật/đề tài bài cũ. 0 = chỉ cảnh báo rồi vẫn viết.
PODCAST_AI_DEDUP_RETRY=2
# Ngưỡng coi là trùng đề tài (0..1, so trên tập từ của tiêu đề + tóm tắt + ý chính). Cao hơn = dễ dãi hơn.
PODCAST_AI_TOPIC_SIM=0.5
# Số thẻ nhớ giữ lại, và số bài gần nhất được kể CHI TIẾT trong prompt (bài cũ hơn chỉ còn tên + nhân vật).
PODCAST_AI_MEMORY_MAX=300
PODCAST_AI_MEMORY_DETAIL=25
